# Regenerating the committed Cap'n Proto code requires two tools:
#   1. The capnp schema compiler:  apt-get install -y capnproto libcapnp-dev
#   2. The capnpc-rust plugin, pinned to the EXACT version CI uses (the
#      generated bytes depend on the plugin version), matching the `capnp`
#      runtime dependency in Cargo.toml:
#          cargo install capnpc --version "=0.23.2"
.PHONY: generate_capnp_types clean_generated_capnp_types

generate_capnp_types:
	capnp compile hypersync_net_types.capnp -o rust:./src/__generated__
	rustfmt src/__generated__/hypersync_net_types_capnp.rs

clean_generated_capnp_types:
	rm -f src/__generated__/hypersync_net_types_capnp.rs
